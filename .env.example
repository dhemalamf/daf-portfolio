# Public identifiers — not secrets. They are exposed to the browser anyway.
# Copy to .env.local to point the site at your own Sanity project / GA property.

# Sanity (blog + Studio at /studio)
NEXT_PUBLIC_SANITY_PROJECT_ID=js6xvhgj
NEXT_PUBLIC_SANITY_DATASET=production

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-CN20Z12C8C

# Canonical origin used by metadata, sitemap and robots
NEXT_PUBLIC_SITE_URL=https://dhema.me

# Server-only secret. Signs the Sanity -> /api/revalidate webhook so publishing
# a post purges the cache immediately. Generate one with `openssl rand -hex 32`
# and send it as the `x-sanity-webhook-secret` header from the Sanity webhook.
# Leave unset and the route stays closed with a 503.
SANITY_REVALIDATE_SECRET=
